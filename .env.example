# Anthropic API key for Claude (writes audit narrative)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token (commits audit data back to the repo + dispatches the workflow)
# Needs: repo + actions:write scope
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=
GITHUB_REPO=client-website-auditor
GITHUB_BRANCH=main

# Shared admin password for the dashboard
ADMIN_PASSWORD=change-me

# Vercel Blob (used to store uploaded logos, Semrush CSVs, Local Dominator screenshots, generated PDFs)
# Auto-set when you enable Blob in the Vercel dashboard:
#   Storage -> Create Database -> Blob -> Connect to project
BLOB_READ_WRITE_TOKEN=

# Google PageSpeed Insights API key (free, 25K queries/day)
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Local Dominator API (optional - falls back to screenshot upload if not set)
# Docs: https://app.localdominator.co/api-doc/
LOCAL_DOMINATOR_API_KEY=
LOCAL_DOMINATOR_API_BASE=https://app.localdominator.co/api
